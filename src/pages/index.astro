---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>♞ Piezas Menores</h1>
				<p class="tagline">{SITE_DESCRIPTION}</p>
				<p>
					En ajedrez, las piezas menores son el alfil y el caballo. No tienen el poder de la dama ni el alcance de la torre,
					pero en las manos correctas, ganan partidas. Este blog es sobre eso: las ideas "menores" que otros subestiman,
					los detalles que acumulan ventaja, y la mentalidad estratégica aplicada a los negocios, las inversiones y la vida.
				</p>
			</section>

			<section class="recent-posts">
				<h2>Últimos artículos</h2>
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<h3>{post.data.title}</h3>
								<p class="date"><FormattedDate date={post.data.pubDate} /></p>
								<p>{post.data.description}</p>
							</a>
						</li>
					))}
				</ul>
				<p class="view-all">
					<a href="/blog">Ver todos los artículos →</a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		margin-bottom: 3rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.hero h1 {
		font-size: 2.5rem;
		margin-bottom: 0.5rem;
	}
	.tagline {
		font-size: 1.25rem;
		color: rgb(var(--gray));
		margin-bottom: 1.5rem;
		font-style: italic;
	}
	.recent-posts h2 {
		margin-bottom: 1.5rem;
	}
	.recent-posts ul {
		list-style: none;
		padding: 0;
	}
	.recent-posts li {
		margin-bottom: 1.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.recent-posts li:last-child {
		border-bottom: none;
	}
	.recent-posts a {
		text-decoration: none;
		color: inherit;
	}
	.recent-posts a:hover h3 {
		color: var(--accent);
	}
	.recent-posts h3 {
		margin-bottom: 0.25rem;
		font-size: 1.25rem;
	}
	.recent-posts .date {
		font-size: 0.875rem;
		color: rgb(var(--gray));
		margin-bottom: 0.5rem;
	}
	.view-all {
		margin-top: 1rem;
	}
	.view-all a {
		font-weight: bold;
	}
</style>

---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import caballo from '../assets/marca/caballo-sepia.png';
import alfil from '../assets/marca/alfil-sepia.png';
import { REDES, SERIES, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const piezas = (await getCollection('piezas')).sort((a, b) => b.data.numero - a.data.numero);
const series = SERIES.map((serie) => ({
	...serie,
	cantidad: piezas.filter((pieza) => pieza.data.serie === serie.nombre).length,
})).filter((serie) => serie.cantidad > 0);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`${SITE_TITLE} — ideas que dieron forma al presente`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="contenedor portada">
				<div class="texto">
					<p class="rotulo entra">Libros · Historia · Tecnología · IA</p>
					<h1 class="entra" style="--orden:1">
						Las ideas que dieron forma <em>al presente.</em>
					</h1>
					<p class="bajada entra" style="--orden:2">
						Piezas de un minuto con una tesis propia y datos verificados. Cada una termina en una jugada de ajedrez.
					</p>
					<ul class="redes entra" style="--orden:3">
						{REDES.map((red) => (
							<li>
								<a class="rotulo" href={red.url} target="_blank" rel="noopener">{red.nombre}</a>
							</li>
						))}
					</ul>
				</div>
				<div class="tablero entra" style="--orden:2" aria-hidden="true">
					<Image class="figura caballo" src={caballo} alt="" width={330} loading="eager" />
					<Image class="figura alfil" src={alfil} alt="" width={250} loading="eager" />
				</div>
			</section>

			<hr class="filete contenedor" />

			<section class="contenedor" id="series">
				<header class="encabezado">
					<h2>Series</h2>
					<p class="rotulo">{piezas.length} piezas publicadas</p>
				</header>
				<ol class="indice">
					{series.map((serie) => (
						<li>
							<span class="nombre">{serie.nombre}</span>
							<span class="puntos" aria-hidden="true"></span>
							<span class="rotulo">{serie.cantidad} {serie.cantidad === 1 ? 'pieza' : 'piezas'}</span>
							<p>{serie.bajada}</p>
						</li>
					))}
				</ol>
			</section>

			<section class="contenedor" id="piezas">
				<header class="encabezado">
					<h2>Piezas</h2>
					<p class="rotulo">De la más nueva a la primera</p>
				</header>
				<ul class="grilla">
					{piezas.map((pieza, indice) => (
						<li class="pieza entra" style={`--orden:${Math.min(indice, 8)}`}>
							<a href={`/piezas/${pieza.id}/`}>
							<Image
								src={pieza.data.portada}
								alt={`Portada de la pieza ${pieza.data.numero}: ${pieza.data.titulo}`}
								width={360}
								loading={indice < 4 ? 'eager' : 'lazy'}
							/>
							<p class="rotulo">
								N.º {String(pieza.data.numero).padStart(2, '0')} · {pieza.data.serie}
							</p>
							<h3>{pieza.data.titulo}</h3>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	section {
		padding-block: clamp(2.5rem, 6vw, 4.5rem);
	}

	/* ── Portada ───────────────────────────── */
	.portada {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(1.5rem, 5vw, 4rem);
	}
	.portada .rotulo {
		color: var(--sepia);
		margin-bottom: 1.2rem;
	}
	h1 {
		font-weight: 900;
		font-size: clamp(2.7rem, 7.2vw, 5.6rem);
		line-height: 0.98;
	}
	h1 em {
		font-weight: 700;
		color: var(--atardecer);
	}
	.bajada {
		font-size: clamp(1.15rem, 1.9vw, 1.4rem);
		max-width: 34ch;
		margin: 1.6rem 0 2rem;
	}
	.redes {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.redes a {
		display: inline-block;
		text-decoration: none;
		padding: 0.8rem 1.15rem;
		border: 3px solid var(--tinta);
		background: var(--papel-claro);
		box-shadow: 6px 6px 0 var(--tinta);
		transition: box-shadow 0.15s, transform 0.15s, background 0.15s;
	}
	.redes li:first-child a {
		background: var(--dorado);
	}
	.redes a:hover {
		transform: translate(-3px, -3px);
		box-shadow: 9px 9px 0 var(--holograma);
	}

	/* Chessboard with the two minor pieces, engraved */
	.tablero {
		position: relative;
		aspect-ratio: 1;
		width: min(100%, 460px);
		justify-self: end;
		background: conic-gradient(var(--casilla) 25%, var(--papel-claro) 0 50%, var(--casilla) 0 75%, var(--papel-claro) 0) 0 0 / 25% 25%;
		border: 4px solid var(--tinta);
		box-shadow: 14px 14px 0 var(--tinta);
		transform: rotate(2.5deg);
	}
	/* The PNGs have a white background: multiply only hides it inside the board */
	.tablero :global(.figura) {
		position: absolute;
		bottom: 5%;
		mix-blend-mode: multiply;
	}
	.tablero :global(.caballo) {
		left: 3%;
		width: 55%;
	}
	.tablero :global(.alfil) {
		right: 4%;
		width: 37%;
	}

	/* ── Encabezados de sección ─────────────── */
	.encabezado {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		flex-wrap: wrap;
		margin-bottom: 2rem;
	}
	h2 {
		font-weight: 900;
		font-size: clamp(2rem, 4.4vw, 3.2rem);
	}
	.encabezado .rotulo {
		color: var(--sepia);
		margin: 0;
	}

	/* ── Índice de series ───────────────────── */
	.indice {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.3rem;
		max-width: 780px;
	}
	.indice li {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: baseline;
		column-gap: 0.7rem;
	}
	.indice .nombre {
		font-family: var(--titulos);
		font-weight: 700;
		font-style: italic;
		font-size: clamp(1.25rem, 2.4vw, 1.65rem);
	}
	.indice .puntos {
		border-bottom: 2px dotted var(--sepia);
		transform: translateY(-0.3em);
	}
	.indice p {
		grid-column: 1 / -1;
		margin: 0.15rem 0 0;
		color: var(--sepia);
		font-size: 1.05rem;
	}

	/* ── Grilla de piezas ───────────────────── */
	.grilla {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
		gap: 2.6rem 2rem;
	}
	.pieza a {
		display: block;
		text-decoration: none;
	}
	.pieza :global(img) {
		width: 100%;
		aspect-ratio: 9 / 16;
		object-fit: cover;
		border: 4px solid var(--tinta);
		box-shadow: 8px 8px 0 var(--tinta);
		transition: box-shadow 0.18s, transform 0.18s;
	}
	.pieza:hover :global(img) {
		transform: translate(-4px, -4px);
		box-shadow: 12px 12px 0 var(--holograma);
	}
	.pieza .rotulo {
		color: var(--sepia);
		margin: 1.3rem 0 0.4rem;
		font-size: 0.66rem;
	}
	h3 {
		font-size: 1.22rem;
		line-height: 1.18;
	}

	@media (max-width: 820px) {
		.portada {
			grid-template-columns: 1fr;
		}
		.tablero {
			justify-self: center;
			width: min(78%, 340px);
			order: -1;
			margin-bottom: 1.5rem;
		}
		.indice li {
			grid-template-columns: 1fr;
		}
		.indice .puntos {
			display: none;
		}
		.grilla {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 2rem 1.2rem;
		}
		.pieza :global(img) {
			box-shadow: 5px 5px 0 var(--tinta);
		}
		h3 {
			font-size: 1.05rem;
		}
	}
</style>

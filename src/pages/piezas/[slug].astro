---
import { getCollection, getEntry, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const piezas = (await getCollection('piezas')).sort((a, b) => a.data.numero - b.data.numero);
	return piezas.map((pieza, indice) => ({
		params: { slug: pieza.id },
		props: { pieza, anterior: piezas[indice - 1], siguiente: piezas[indice + 1] },
	}));
}

const { pieza, anterior, siguiente } = Astro.props;
const { numero, titulo, serie, portada, bajada, youtube, jugada, narracion } = pieza.data;
const { Content } = await render(pieza);
const tieneDatos = Boolean(pieza.body?.trim());
const nota = await getEntry('notas', pieza.id);
const Nota = nota ? (await render(nota)).Content : null;
const [gancho, ...resto] = narracion;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`${titulo} — ${SITE_TITLE}`} description={bajada} image={portada} />
	</head>
	<body>
		<Header />
		<main class="contenedor">
			<article>
				<header class="titulo">
					<p class="rotulo entra">N.º {String(numero).padStart(2, '0')} · {serie}</p>
					<h1 class="entra" style="--orden:1">{titulo}</h1>
					<p class="bajada entra" style="--orden:2">{bajada}</p>
				</header>

				<div class="cuerpo">
					<div class="video entra" style="--orden:2">
						<iframe
							src={`https://www.youtube-nocookie.com/embed/${youtube}`}
							title={titulo}
							loading="lazy"
							allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share"
							allowfullscreen
						/>
					</div>

					<div class="texto">
						{narracion.length > 0 && (
							<section>
								<h2 class="rotulo">La pieza, en texto</h2>
								<p class="gancho">{gancho}</p>
								{resto.map((parrafo) => <p>{parrafo}</p>)}
							</section>
						)}

						{jugada && (
							<aside class="jugada">
								<p class="rotulo">La jugada</p>
								<p class="concepto">{jugada.concepto}</p>
								<p class="definicion">{jugada.definicion}</p>
							</aside>
						)}
					</div>
				</div>

				{nota && Nota && (
					<section class="nota-larga">
						<p class="rotulo">La historia completa{nota.data.borrador && ' · borrador sin verificar'}</p>
						<h2>{nota.data.titulo}</h2>
						<div class="prosa"><Nota /></div>
					</section>
				)}

				{tieneDatos && (
					<section class="datos">
						<h2>Datos verificados</h2>
						<p class="nota">Lo que la pieza afirma como hecho, con la fuente contra la que se contrastó antes de publicar.</p>
						<Content />
					</section>
				)}

				<nav class="otras" aria-label="Otras piezas">
					{anterior ? (
						<a href={`/piezas/${anterior.id}/`}>
							<span class="rotulo">← Anterior</span>
							{anterior.data.titulo}
						</a>
					) : <span />}
					{siguiente && (
						<a class="derecha" href={`/piezas/${siguiente.id}/`}>
							<span class="rotulo">Siguiente →</span>
							{siguiente.data.titulo}
						</a>
					)}
				</nav>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	article {
		padding-block: clamp(2.2rem, 5vw, 4rem);
	}
	.rotulo {
		color: var(--sepia);
		margin: 0 0 1rem;
	}
	.titulo {
		max-width: 900px;
		margin-bottom: clamp(2rem, 5vw, 3.5rem);
	}
	h1 {
		font-weight: 900;
		font-size: clamp(2.2rem, 5.4vw, 4.2rem);
		line-height: 1.02;
	}
	.bajada {
		font-size: clamp(1.1rem, 1.7vw, 1.3rem);
		max-width: 62ch;
		margin: 1.4rem 0 0;
	}

	.cuerpo {
		display: grid;
		grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: start;
	}
	.video {
		position: sticky;
		top: 1.5rem;
	}
	.video iframe {
		display: block;
		width: 100%;
		aspect-ratio: 9 / 16;
		height: auto;
		border: 4px solid var(--tinta);
		box-shadow: 12px 12px 0 var(--tinta);
		background: var(--tinta);
	}

	.texto {
		max-width: 60ch;
	}
	.texto p {
		font-size: 1.22rem;
		line-height: 1.6;
	}
	.texto .gancho {
		font-family: var(--titulos);
		font-style: italic;
		font-weight: 700;
		font-size: clamp(1.5rem, 2.6vw, 2rem);
		line-height: 1.22;
		margin-bottom: 1.3rem;
	}

	.jugada {
		margin-top: 2.5rem;
		background: var(--tinta);
		color: var(--papel);
		padding: 1.6rem 1.8rem 1.8rem;
		box-shadow: 10px 10px 0 var(--dorado);
	}
	.jugada .rotulo {
		color: var(--dorado);
		margin-bottom: 0.5rem;
	}
	.jugada .concepto {
		font-family: var(--titulos);
		font-weight: 900;
		font-style: italic;
		font-size: 2.2rem;
		line-height: 1.1;
		margin: 0 0 0.4rem;
	}
	.jugada .definicion {
		margin: 0;
		font-size: 1.1rem;
	}
	.jugada .definicion::first-letter {
		text-transform: uppercase;
	}

	.nota-larga {
		margin-top: clamp(3rem, 7vw, 5rem);
		padding-top: 1.6rem;
		border-top: 3px solid var(--tinta);
		max-width: 68ch;
	}
	.nota-larga > h2 {
		font-weight: 900;
		font-size: clamp(2rem, 4.4vw, 3.2rem);
		line-height: 1.05;
		margin-bottom: 1.6rem;
	}
	.prosa :global(p) {
		font-size: 1.22rem;
		line-height: 1.65;
		margin-bottom: 1.2em;
	}
	.prosa :global(p:first-of-type)::first-letter {
		font-family: var(--titulos);
		font-weight: 900;
		font-size: 3.6em;
		float: left;
		line-height: 0.82;
		padding: 0.08em 0.1em 0 0;
		color: var(--atardecer);
	}
	.prosa :global(h2) {
		font-style: italic;
		font-size: 1.7rem;
		margin: 2.4rem 0 0.8rem;
	}

	.datos {
		margin-top: clamp(3rem, 7vw, 5rem);
		padding-top: 1.6rem;
		border-top: 3px solid var(--tinta);
		max-width: 900px;
	}
	.datos h2 {
		font-weight: 900;
		font-size: clamp(1.7rem, 3.4vw, 2.4rem);
	}
	.nota {
		color: var(--sepia);
		font-style: italic;
		margin: 0.5rem 0 1.6rem;
	}
	.datos :global(ul) {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.datos :global(li) {
		padding: 0.9rem 0;
		border-bottom: 1px dotted var(--sepia);
		font-size: 1.05rem;
		line-height: 1.5;
	}
	.datos :global(li em) {
		color: var(--sepia);
		font-size: 0.95rem;
	}

	.otras {
		margin-top: clamp(3rem, 7vw, 5rem);
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
	}
	.otras a {
		text-decoration: none;
		font-family: var(--titulos);
		font-weight: 700;
		font-size: 1.15rem;
		line-height: 1.25;
	}
	.otras a:hover {
		color: var(--atardecer);
	}
	.otras .rotulo {
		display: block;
		margin-bottom: 0.4rem;
	}
	.otras .derecha {
		text-align: right;
	}

	@media (max-width: 820px) {
		.cuerpo {
			grid-template-columns: 1fr;
		}
		.video {
			position: static;
			width: min(100%, 320px);
			margin-inline: auto;
		}
		.video iframe {
			box-shadow: 8px 8px 0 var(--tinta);
		}
		.otras {
			grid-template-columns: 1fr;
		}
		.otras .derecha {
			text-align: left;
		}
	}
</style>

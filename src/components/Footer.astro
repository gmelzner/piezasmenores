---
import { CONTACTO, REDES, SITE_TITLE } from '../consts';
---

<footer class="pie">
	<div class="contenedor columnas">
		<div>
			<p class="firma">♞♝ {SITE_TITLE}</p>
			<p class="aviso">
				Tesis y verificación a cargo de una persona. Guion, narración, música e ilustraciones generados con
				inteligencia artificial.
			</p>
		</div>
		<ul class="enlaces rotulo">
			{REDES.map((red) => (
				<li><a href={red.url} target="_blank" rel="noopener">{red.nombre}</a></li>
			))}
			<li><a href={`mailto:${CONTACTO}`}>{CONTACTO}</a></li>
		</ul>
	</div>
</footer>

<style>
	.pie {
		margin-top: clamp(4rem, 9vw, 7rem);
		background: var(--tinta);
		color: var(--papel);
		padding: 3rem 0 3.5rem;
		border-top: 6px solid var(--dorado);
	}
	.columnas {
		display: flex;
		justify-content: space-between;
		gap: 2rem 4rem;
		flex-wrap: wrap;
	}
	.firma {
		font-family: var(--titulos);
		font-weight: 900;
		font-size: 1.6rem;
		margin: 0 0 0.6rem;
	}
	.aviso {
		max-width: 34ch;
		font-size: 1rem;
		font-style: italic;
		color: color-mix(in srgb, var(--papel) 72%, transparent);
		margin: 0;
	}
	.enlaces {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.75rem;
		align-content: start;
	}
	.enlaces a {
		text-decoration: none;
		border-bottom: 2px solid var(--atardecer);
		padding-bottom: 0.15rem;
	}
	.enlaces a:hover {
		border-bottom-color: var(--holograma);
		color: var(--holograma);
	}
	.enlaces a:focus-visible {
		outline-color: var(--holograma);
	}
</style>

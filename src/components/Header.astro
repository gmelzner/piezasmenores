---
import { REDES, SITE_TITLE } from '../consts';

const enlaces = [
	{ href: '/#piezas', texto: 'Piezas' },
	{ href: '/#series', texto: 'Series' },
	{ href: '/canal', texto: 'El canal' },
	{ href: '/como-se-hace', texto: 'Cómo se hace' },
];
const canal = REDES[0];
---

<header class="cabecera">
	<div class="contenedor fila">
		<a class="marca" href="/">
			<span class="piezas" aria-hidden="true">♞♝</span>
			<span class="nombre">{SITE_TITLE}</span>
		</a>
		<nav aria-label="Principal">
			{enlaces.map((enlace) => <a class="rotulo" href={enlace.href}>{enlace.texto}</a>)}
			<a class="rotulo destacado" href={canal.url} target="_blank" rel="noopener">Ver en {canal.nombre}</a>
		</nav>
	</div>
	<hr class="filete" />
</header>

<style>
	.cabecera {
		padding-top: 1.1rem;
	}
	.fila {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem 2rem;
		flex-wrap: wrap;
		padding-bottom: 0.9rem;
	}
	.marca {
		display: inline-flex;
		align-items: baseline;
		gap: 0.55rem;
		text-decoration: none;
	}
	.piezas {
		font-size: 1.5rem;
		letter-spacing: -0.12em;
		color: var(--atardecer);
	}
	.nombre {
		font-family: var(--titulos);
		font-weight: 900;
		font-size: 1.55rem;
		letter-spacing: -0.02em;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 0.4rem 1.4rem;
		flex-wrap: wrap;
	}
	nav a {
		text-decoration: none;
		padding: 0.35rem 0;
		border-bottom: 2px solid transparent;
	}
	nav a:hover {
		border-bottom-color: var(--atardecer);
	}
	nav a.destacado {
		background: var(--tinta);
		color: var(--papel);
		padding: 0.5rem 0.8rem;
		border: 0;
		box-shadow: 4px 4px 0 var(--dorado);
		transition: box-shadow 0.15s, transform 0.15s;
	}
	nav a.destacado:hover {
		box-shadow: 6px 6px 0 var(--holograma);
		transform: translate(-2px, -2px);
	}
</style>
